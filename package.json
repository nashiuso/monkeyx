{
  "name": "monkeyx",
  "version": "0.3.0",
  "description": "Deterministic monkey avatars as SVG. Same seed, same monkey.",
  "license": "BSD-3-Clause",
  "author": "nashiuso",
  "type": "module",
  "sideEffects": [
    "./src/traits/families.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "monkeyx": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "npm run build",
    "samples": "node scripts/render-samples.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "visual:baseline": "node scripts/render-visual-baseline.mjs"
  },
  "keywords": [
    "avatar",
    "svg",
    "deterministic",
    "generator",
    "monkey",
    "identicon",
    "placeholder",
    "character",
    "animation",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nashiuso/monkeyx.git"
  },
  "bugs": {
    "url": "https://github.com/nashiuso/monkeyx/issues"
  },
  "homepage": "https://github.com/nashiuso/monkeyx#readme",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@resvg/resvg-js": "^2.6.0",
    "@types/node": "^22.0.0",
    "@xmldom/xmldom": "^0.9.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
